# cp .env.example .env 후 값만 바꾼다. compose가 자동 인식, npm run dev/start는 server.ts가 자동 로드.
# shell에 직접 export한 값이 .env보다 우선한다.
# 아래 값은 모두 코드 기본값과 동일하다 — 그대로 두면 dtx-fhir application-test.yaml과 맞는다.
PORT=8091
PUBLIC_BASE_URL=http://localhost:8091
CLIENT_ID=test-client-id
CLIENT_SECRET=test-client-secret
GOV_CLIENT_ID=test-gov-client-id
GOV_CLIENT_SECRET=test-gov-client-secret
# HOST 기본값은 127.0.0.1(루프백)이다. 같은 네트워크의 다른 기기에서 접속해야 할 때만 0.0.0.0으로 바꾼다.
# /admin에는 인증이 없으므로 외부 노출은 금지한다(SECURITY.md).
# HOST=0.0.0.0
# CLIENT_* 변경은 첫 기동 1회만 시드되어 SQLite에 영속된다.
# 변경 후: docker compose down && rm -rf ./data && docker compose up -d --build
